{
  "name": "no-coauthor",
  "displayName": "No Co-Author Trailer",
  "version": "1.0.0",
  "description": "Strips the Co-Authored-By trailer from git commit commands before they run.",
  "author": {
    "name": "anetrebskii"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/strip-coauthor.sh"
          }
        ]
      }
    ]
  }
}
